<?xml version="1.0" encoding="utf-8"?>
<!-- The launch screen's logo: the launcher icon, its disc growing in and the arrow popping up. Android masks it to
     the inner two thirds, the same circle the launcher shows. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="432dp" android:height="432dp"
            android:viewportWidth="108" android:viewportHeight="108">
            <group android:name="disc" android:pivotX="54" android:pivotY="54">
                <path android:pathData="M0,0h108v108h-108z">
                    <aapt:attr name="android:fillColor">
                        <gradient
                            android:type="linear"
                            android:startX="54" android:startY="0"
                            android:endX="54" android:endY="108">
                            <item android:offset="0" android:color="#FF444444" />
                            <item android:offset="0.244" android:color="#FF282828" />
                            <item android:offset="0.427" android:color="#FF131313" />
                            <item android:offset="0.557" android:color="#FF070707" />
                            <item android:offset="0.6875" android:color="#FF000000" />
                            <item android:offset="1" android:color="#FF000000" />
                        </gradient>
                    </aapt:attr>
                </path>
            </group>
            <group android:name="arrow" android:pivotX="54" android:pivotY="54">
                <path
                    android:name="arrowPath"
                    android:fillColor="@android:color/white"
                    android:pathData="M52.47,33.55 A1.73,1.73 0 0,1 55.53,33.55 L76.76,74.34 A0.95,0.95 0 0,1 75.59,75.67 L54,67.68 L32.41,75.67 A0.95,0.95 0 0,1 31.24,74.34 Z" />
            </group>
        </vector>
    </aapt:attr>
    <target android:name="disc">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator android:propertyName="scaleX" android:valueFrom="0.6" android:valueTo="1"
                    android:duration="350" android:interpolator="@android:interpolator/fast_out_slow_in" />
                <objectAnimator android:propertyName="scaleY" android:valueFrom="0.6" android:valueTo="1"
                    android:duration="350" android:interpolator="@android:interpolator/fast_out_slow_in" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="arrow">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator android:propertyName="scaleX" android:valueFrom="0.4" android:valueTo="1"
                    android:startOffset="80" android:duration="450" android:interpolator="@android:anim/overshoot_interpolator" />
                <objectAnimator android:propertyName="scaleY" android:valueFrom="0.4" android:valueTo="1"
                    android:startOffset="80" android:duration="450" android:interpolator="@android:anim/overshoot_interpolator" />
                <objectAnimator android:propertyName="translateY" android:valueFrom="8" android:valueTo="0"
                    android:startOffset="80" android:duration="450" android:interpolator="@android:interpolator/fast_out_slow_in" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="arrowPath">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="fillAlpha" android:valueFrom="0" android:valueTo="1"
                android:startOffset="80" android:duration="200" android:interpolator="@android:interpolator/linear" />
        </aapt:attr>
    </target>
</animated-vector>
